{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer"
    },
    "waitingMs": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "path",
          "sha256",
          "snapshot"
        ],
        "additionalProperties": false
      }
    },
    "deployment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "environment": {
              "const": "Dev"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ]
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40,64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verified": {
              "type": "boolean"
            }
          },
          "required": [
            "environment",
            "url",
            "id",
            "commit",
            "source",
            "observedAt",
            "verified"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentState": {
      "enum": [
        "reliable",
        "session-invalid",
        "deployment-changed",
        "data-contaminated",
        "mutation-uncertain"
      ]
    },
    "stopCampaign": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "endedAt",
    "recordedAt",
    "durationMs",
    "waitingMs",
    "outcome",
    "steps",
    "observations",
    "limitations",
    "evidence",
    "deployment",
    "environmentState",
    "stopCampaign"
  ],
  "additionalProperties": false
}
