{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "revision": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "rights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "syntheticData": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "persistentEffects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      },
      "maxItems": 50
    },
    "approval": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "human",
            "editorial"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "actor",
        "approvedAt",
        "proposalSha256",
        "decisionSha256",
        "contentSha256",
        "contractSha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "theme",
    "revision",
    "status",
    "references",
    "actor",
    "rights",
    "preconditions",
    "syntheticData",
    "objective",
    "actions",
    "assertions",
    "persistentEffects",
    "cleanup",
    "stopConditions",
    "dependencies"
  ],
  "additionalProperties": false
}
