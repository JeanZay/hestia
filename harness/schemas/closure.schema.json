{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registre technique commun des branches et worktrees Hestia",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","repository","recordedAtUtc","entries"],
  "properties": {"schemaVersion":{"const":1},"repository":{"$ref":"#/$defs/repository"},"recordedAtUtc":{"$ref":"#/$defs/date"},"entries":{"type":"array","minItems":0,"maxItems":500,"items":{"$ref":"#/$defs/entry"}}},
  "$defs": {
    "text": {"type":"string","minLength":1,"maxLength":20000,"pattern":"\\S"},
    "key": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,99}$"},
    "date": {"type":"string","format":"date-time"},
    "head": {"type":"string","pattern":"^[a-f0-9]{40}(?:[a-f0-9]{24})?$"},
    "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "repository": {"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "branch": {"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "pr": {"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"},
    "file": {"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/digest"}}},
    "nextAction": {"type":"object","additionalProperties":false,"required":["owner","action","support","expectedResponse","unblocks"],"properties":{"owner":{"enum":["Amaury","agent"]},"action":{"$ref":"#/$defs/text"},"support":{"$ref":"#/$defs/text"},"expectedResponse":{"$ref":"#/$defs/text"},"unblocks":{"$ref":"#/$defs/text"}}},
    "candidate": {"type":"object","additionalProperties":false,"required":["head","sourceDigest"],"properties":{"head":{"$ref":"#/$defs/head"},"sourceDigest":{"$ref":"#/$defs/digest"}}},
    "validation": {"type":"object","additionalProperties":false,"required":["kind","repository","branch","head","target","recordedAtUtc","sourceDigest","status","checks","evidence","evidenceRoot"],"properties":{"kind":{"const":"validation"},"repository":{"$ref":"#/$defs/repository"},"branch":{"$ref":"#/$defs/branch"},"head":{"$ref":"#/$defs/head"},"target":{"$ref":"#/$defs/branch"},"recordedAtUtc":{"$ref":"#/$defs/date"},"sourceDigest":{"$ref":"#/$defs/digest"},"status":{"enum":["PASS","FAIL","NOT_PERFORMED","BLOCKED"]},"checks":{"type":"array","minItems":1,"maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["name","status","exitCode"],"properties":{"name":{"$ref":"#/$defs/text"},"status":{"enum":["PASS","FAIL","NOT_PERFORMED"]},"exitCode":{"type":["integer","null"]}}}},"evidence":{"$ref":"#/$defs/file"},"evidenceRoot":{"$ref":"#/$defs/text"}}},
    "review": {"type":"object","additionalProperties":false,"required":["kind","repository","branch","head","target","recordedAtUtc","sourceDigest","status","authors","reviewer","openBlockingFindings","evidence","evidenceRead"],"properties":{"kind":{"const":"review"},"repository":{"$ref":"#/$defs/repository"},"branch":{"$ref":"#/$defs/branch"},"head":{"$ref":"#/$defs/head"},"target":{"$ref":"#/$defs/branch"},"recordedAtUtc":{"$ref":"#/$defs/date"},"sourceDigest":{"$ref":"#/$defs/digest"},"status":{"enum":["PASS","CHANGES_REQUIRED","NOT_PERFORMED","BLOCKED"]},"authors":{"type":"array","minItems":1,"maxItems":50,"items":{"$ref":"#/$defs/key"}},"reviewer":{"type":"object","additionalProperties":false,"required":["identity","effectiveModel","cleanContext"],"properties":{"identity":{"$ref":"#/$defs/key"},"effectiveModel":{"$ref":"#/$defs/text"},"cleanContext":{"const":true}}},"openBlockingFindings":{"type":"integer"},"evidence":{"$ref":"#/$defs/file"},"evidenceRead":{"const":true}}},
    "authorization": {"type":"object","additionalProperties":false,"required":["kind","repository","branch","head","target","recordedAtUtc","pr","actions","source","quote"],"properties":{"kind":{"const":"authorization"},"repository":{"$ref":"#/$defs/repository"},"branch":{"$ref":"#/$defs/branch"},"head":{"$ref":"#/$defs/head"},"target":{"$ref":"#/$defs/branch"},"recordedAtUtc":{"$ref":"#/$defs/date"},"pr":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/pr"}]},"actions":{"type":"array","minItems":1,"maxItems":4,"items":{"enum":["merge","abandon","cleanup","defer"]}},"source":{"$ref":"#/$defs/file"},"quote":{"$ref":"#/$defs/text"}}},
    "reservation": {"type":"object","additionalProperties":false,"required":["kind","repository","lotId","branch","target","baseHead","paths","recordedAtUtc","source","quote","nextAction","worktree"],"properties":{"kind":{"const":"reservation"},"repository":{"$ref":"#/$defs/repository"},"lotId":{"$ref":"#/$defs/key"},"branch":{"$ref":"#/$defs/branch"},"target":{"$ref":"#/$defs/branch"},"baseHead":{"$ref":"#/$defs/head"},"paths":{"type":"array","minItems":1,"maxItems":200,"items":{"$ref":"#/$defs/text"}},"recordedAtUtc":{"$ref":"#/$defs/date"},"source":{"$ref":"#/$defs/file"},"quote":{"$ref":"#/$defs/text"},"nextAction":{"$ref":"#/$defs/nextAction"},"worktree":{"$ref":"#/$defs/text"}}},
    "remoteReceipt": {"type":"object","additionalProperties":false,"required":["kind","repository","branch","head","target","recordedAtUtc","pr","mergeCommit","targetHead","merged","comparison"],"properties":{"kind":{"const":"remote-merge-receipt"},"repository":{"$ref":"#/$defs/repository"},"branch":{"$ref":"#/$defs/branch"},"head":{"$ref":"#/$defs/head"},"target":{"$ref":"#/$defs/branch"},"recordedAtUtc":{"$ref":"#/$defs/date"},"pr":{"$ref":"#/$defs/pr"},"mergeCommit":{"$ref":"#/$defs/head"},"targetHead":{"$ref":"#/$defs/head"},"merged":{"const":true},"comparison":{"enum":["identical","ahead"]}}},
    "disposition": {"type":"object","additionalProperties":false,"required":["kind","repository","branch","head","target","recordedAtUtc","pr","reason","authorization","mergeCommit","remoteReceipt"],"properties":{"kind":{"enum":["ready","blocked","deferred","abandoned","merged"]},"repository":{"$ref":"#/$defs/repository"},"branch":{"$ref":"#/$defs/branch"},"head":{"$ref":"#/$defs/head"},"target":{"$ref":"#/$defs/branch"},"recordedAtUtc":{"$ref":"#/$defs/date"},"pr":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/pr"}]},"reason":{"$ref":"#/$defs/text"},"authorization":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/file"}]},"mergeCommit":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/head"}]},"remoteReceipt":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/file"}]},"preserved":{"type":"array","minItems":0,"maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","copy"],"properties":{"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/digest"},"copy":{"$ref":"#/$defs/file"}}}}}},
    "entry": {"type":"object","additionalProperties":false,"required":["lotId","branch","target","state","reason","source","candidate","proofs","authorization","disposition","reservation","nextAction"],"properties":{"lotId":{"$ref":"#/$defs/key"},"branch":{"$ref":"#/$defs/branch"},"target":{"$ref":"#/$defs/branch"},"state":{"enum":["working","ready","blocked","deferred","merged"]},"reason":{"$ref":"#/$defs/text"},"source":{"$ref":"#/$defs/file"},"candidate":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/candidate"}]},"proofs":{"type":"object","additionalProperties":false,"required":["validation","review"],"properties":{"validation":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/file"}]},"review":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/file"}]}}},"authorization":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/file"}]},"disposition":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/file"}]},"reservation":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/file"}]},"nextAction":{"$ref":"#/$defs/nextAction"}}}
  }
}
