{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,96}$"
    },
    "proposalSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "kind": {
      "enum": [
        "human",
        "editorial"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "diff": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "proposalId",
    "proposalSha256",
    "verdict",
    "kind",
    "actor",
    "author",
    "decidedAt",
    "source",
    "quote",
    "review",
    "diff"
  ],
  "additionalProperties": false
}
