# Valeurs privées à fournir hors Git. npm run test:e2e les crée en mémoire.
HESTIA_ENVIRONMENT=local
AUTH_BASE_URL=http://127.0.0.1:3000
AUTH_SECRET=
DATABASE_URL=
NEXT_TELEMETRY_DISABLED=1
# Stockage S3 privé, distinct pour chaque environnement. Ne jamais versionner les clés.
HESTIA_STORAGE_MODE=local
HESTIA_S3_BUCKET_ACCESS=private
HESTIA_S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Secret serveur distinct (>=32 caractères) pour la maintenance authentifiée.
# La route est fermée si absent. Ne jamais le fournir au navigateur.
CRON_SECRET=
# Courriels : désactivés en local et sans fournisseur explicite.
HESTIA_MAIL_PROVIDER=
HESTIA_MAIL_FROM=
RESEND_API_KEY=
# Secret dédié (>=32 caractères), distinct des secrets d'auth et maintenance.
MAIL_WORKER_SECRET=
# CLI seulement, protection Preview Vercel éventuelle. Jamais transmis à Resend.
VERCEL_AUTOMATION_BYPASS_SECRET=
